#!/usr/bin/env node
// Built install: dist/ms.js exists and is at least as new as every file
// under src/. Dev: fall back to the TypeScript sources via tsx (tests run
// this file with `node --import tsx`). MS_ENTRY=src|dist overrides the
// mtime check. No runtime deps — resolve-entry.mjs is a plain ESM sibling.
import { fileURLToPath } from "node:url";
import path from "node:path";
import { resolveEntry } from "./resolve-entry.mjs";
const here = path.dirname(fileURLToPath(import.meta.url));
const entry = resolveEntry(here);
const { main } = await import(entry);
process.exitCode = await main(process.argv.slice(2));
