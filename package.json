{
  "name": "model-switcher",
  "version": "0.1.0",
  "description": "Run claude and codex on whichever of your accounts has room; rotate a walled session in place.",
  "type": "module",
  "bin": { "ms": "bin/ms" },
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "node scripts/build.mjs",
